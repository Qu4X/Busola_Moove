{{!
    @template theme_ebusola/footer

    Stopka Szkoły Żeglarstwa Busola z oficjalnym logo platformy.
}}

<footer id="page-footer" style="background:#0F1547;color:#FFFFFF;margin-top:auto;border-top:none;">
    <div style="max-width:1200px;margin:0 auto;padding:56px 32px 28px;box-sizing:border-box;">
        <div style="display:flex;flex-wrap:wrap;gap:40px 56px;">
            <div style="flex:1 1 260px;min-width:0;">
                <a href="{{{homeurl}}}" style="text-decoration:none;display:inline-block;" aria-label="{{sitename}}">
                    {{# output.should_display_logo }}
                        {{#output.get_logo_dark}}
                            <img src="{{output.get_logo_dark}}" class="footer-logo mb-2" alt="{{sitename}}" style="max-height:48px;width:auto;object-fit:contain;" />
                        {{/output.get_logo_dark}}
                        {{^output.get_logo_dark}}
                            <img src="{{output.get_compact_logo_url}}" class="footer-logo mb-2" alt="{{sitename}}" style="max-height:48px;width:auto;object-fit:contain;" />
                        {{/output.get_logo_dark}}
                    {{/ output.should_display_logo }}
                    {{^ output.should_display_logo }}
                        <div style="display:flex;flex-direction:column;line-height:1;">
                            <span style="font-size:24px;font-weight:700;letter-spacing:.15em;color:#FFFFFF;">{{sitename}}</span>
                        </div>
                    {{/ output.should_display_logo }}
                </a>
                <p style="margin:12px 0 0;font-size:15px;color:#C9CFF2;max-width:280px;line-height:1.5;">Kursy żeglarskie i motorowodne online, w Twoim tempie.</p>
            </div>

            <div style="flex:0 1 180px;min-width:0;">
                <div style="font-size:13px;font-weight:700;letter-spacing:.12em;color:#FFB27A;margin-bottom:12px;">DOKUMENTY</div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <a href="{{#termsurl}}{{{termsurl}}}{{/termsurl}}{{^termsurl}}https://kursybusola.pl{{/termsurl}}" target="_blank" rel="noopener noreferrer" style="color:#FFFFFF;text-decoration:none;font-size:15px;">Regulamin</a>
                    <a href="{{#privacyurl}}{{{privacyurl}}}{{/privacyurl}}{{^privacyurl}}https://kursybusola.pl{{/privacyurl}}" target="_blank" rel="noopener noreferrer" style="color:#FFFFFF;text-decoration:none;font-size:15px;">Polityka prywatności</a>
                    <a href="{{#rodourl}}{{{rodourl}}}{{/rodourl}}{{^rodourl}}https://kursybusola.pl{{/rodourl}}" target="_blank" rel="noopener noreferrer" style="color:#FFFFFF;text-decoration:none;font-size:15px;">RODO</a>
                </div>
            </div>

            <div style="flex:0 1 180px;min-width:0;">
                <div style="font-size:13px;font-weight:700;letter-spacing:.12em;color:#FFB27A;margin-bottom:12px;">KONTAKT</div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <a href="{{#website}}{{{website}}}{{/website}}{{^website}}https://kursybusola.pl{{/website}}" target="_blank" rel="noopener noreferrer" style="color:#FFFFFF;text-decoration:none;font-size:15px;">Strona internetowa</a>
                    <a href="mailto:{{#mail}}{{{mail}}}{{/mail}}{{^mail}}kontakt@kursybusola.pl{{/mail}}" style="color:#FFFFFF;text-decoration:none;font-size:15px;">Napisz do nas</a>
                    {{#mobile}}
                        <a href="tel:{{{mobile}}}" style="color:#FFFFFF;text-decoration:none;font-size:15px;">{{{mobile}}}</a>
                    {{/mobile}}
                </div>
            </div>

            <div style="flex:0 1 200px;min-width:0;">
                <div style="font-size:13px;font-weight:700;letter-spacing:.12em;color:#FFB27A;margin-bottom:12px;">OBSERWUJ NAS</div>
                <div style="display:flex;gap:10px;align-items:center;">
                    <a href="{{#tiktok}}{{{tiktok}}}{{/tiktok}}{{^tiktok}}https://www.tiktok.com/@kursybusola{{/tiktok}}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" style="width:44px;height:44px;border-radius:22px;border:1.5px solid rgba(255,255,255,.4);display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF;text-decoration:none;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v11.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M12 3c.4 2.6 2.2 4.2 4.8 4.4"></path></svg>
                    </a>
                    <a href="{{#facebook}}{{{facebook}}}{{/facebook}}{{^facebook}}https://www.facebook.com/kursybusola{{/facebook}}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="width:44px;height:44px;border-radius:22px;border:1.5px solid rgba(255,255,255,.4);display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF;text-decoration:none;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h2.5V4.5H14A4 4 0 0 0 10 8.5V11H7.5v3.5H10V21h3.5v-6.5h2.6l.6-3.5h-3.2V9c0-.6.4-1 1-1z"></path></svg>
                    </a>
                    <a href="{{#instagram}}{{{instagram}}}{{/instagram}}{{^instagram}}https://www.instagram.com/kursybusola{{/instagram}}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="width:44px;height:44px;border-radius:22px;border:1.5px solid rgba(255,255,255,.4);display:inline-flex;align-items:center;justify-content:center;color:#FFFFFF;text-decoration:none;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5"></rect><circle cx="12" cy="12" r="3.6"></circle><path d="M16.8 7.2h.01"></path></svg>
                    </a>
                </div>
            </div>
        </div>

        <div style="margin-top:40px;padding-top:20px;border-top:1px solid rgba(255,255,255,.16);font-size:13px;color:#B7BEE6;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
            <div>Wspierane przez <a href="https://moodle.org" target="_blank" rel="noopener noreferrer" style="color:#FFFFFF;text-decoration:underline;">Moodle</a></div>
            <div style="color:#B7BEE6;font-size:12px;">Szkoła Żeglarstwa Busola &copy; 2026</div>
        </div>
    </div>

    {{#output.debug_footer_html}}
        <div class="footer-content-debugging footer-dark bg-dark text-light p-3">
            <div class="container-fluid">
                {{{ output.debug_footer_html }}}
            </div>
        </div>
    {{/output.debug_footer_html}}

    <div class="d-none">
        {{{ output.standard_footer_html }}}
        {{{ output.login_info }}}
        <div class="tool_usertours-resettourcontainer"></div>
    </div>
</footer>

{{{ output.standard_end_of_body_html }}}
