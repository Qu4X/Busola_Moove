{{!
    @template theme_ebusola/footer

    Stopka Szkoły Żeglarstwa Busola z oficjalnym logo platformy.
}}

<footer id="page-footer" class="busola-page-footer">
    <div class="busola-footer-inner">
        <div class="busola-footer-cols">
            <!-- Wiersz 1 / Kolumna 1: Logo i opis -->
            <div class="busola-footer-brand">
                <a href="{{{homeurl}}}" class="busola-footer-logo-link" aria-label="{{sitename}}">
                    {{# output.should_display_logo }}
                        {{#output.get_logo_dark}}
                            <img src="{{output.get_logo_dark}}" class="footer-logo mb-2" alt="{{sitename}}" width="{{output.get_logo_width}}" height="{{output.get_logo_height}}" loading="lazy" decoding="async" />
                        {{/output.get_logo_dark}}
                        {{^output.get_logo_dark}}
                            <img src="{{output.get_logo}}" class="footer-logo mb-2" alt="{{sitename}}" width="{{output.get_logo_width}}" height="{{output.get_logo_height}}" loading="lazy" decoding="async" />
                        {{/output.get_logo_dark}}
                    {{/ output.should_display_logo }}
                    {{^ output.should_display_logo }}
                        <div class="busola-footer-logo-text">
                            <span class="busola-footer-sitename">{{sitename}}</span>
                        </div>
                    {{/ output.should_display_logo }}
                </a>
                <p class="busola-footer-desc">Kursy żeglarskie i motorowodne online, w Twoim tempie.</p>
            </div>

            <!-- Kolumna 2: Dokumenty -->
            <div class="busola-footer-col busola-footer-docs">
                <div class="busola-footer-heading">DOKUMENTY</div>
                <div class="busola-footer-links">
                    <a href="{{#termsurl}}{{{termsurl}}}{{/termsurl}}{{^termsurl}}https://kursybusola.pl{{/termsurl}}" target="_blank" rel="noopener noreferrer">Regulamin</a>
                    <a href="{{#privacyurl}}{{{privacyurl}}}{{/privacyurl}}{{^privacyurl}}https://kursybusola.pl{{/privacyurl}}" target="_blank" rel="noopener noreferrer">Polityka prywatności</a>
                    <a href="{{#rodourl}}{{{rodourl}}}{{/rodourl}}{{^rodourl}}https://kursybusola.pl{{/rodourl}}" target="_blank" rel="noopener noreferrer">RODO</a>
                </div>
            </div>

            <!-- Kolumna 3: Kontakt -->
            <div class="busola-footer-col busola-footer-contact">
                <div class="busola-footer-heading">KONTAKT</div>
                <div class="busola-footer-links">
                    <a href="{{#website}}{{{website}}}{{/website}}{{^website}}https://kursybusola.pl{{/website}}" target="_blank" rel="noopener noreferrer">Strona internetowa</a>
                    <a href="mailto:{{#mail}}{{{mail}}}{{/mail}}{{^mail}}kontakt@kursybusola.pl{{/mail}}">Napisz do nas</a>
                    {{#mobile}}
                        <a href="tel:{{{mobile}}}">{{{mobile}}}</a>
                    {{/mobile}}
                </div>
            </div>

            <!-- Kolumna 4: Obserwuj nas -->
            <div class="busola-footer-col busola-footer-socials">
                <div class="busola-footer-heading">OBSERWUJ NAS</div>
                <div class="busola-footer-social-icons">
                    <a href="{{#tiktok}}{{{tiktok}}}{{/tiktok}}{{^tiktok}}https://www.tiktok.com/@kursybusola{{/tiktok}}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="busola-social-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v11.5a3.5 3.5 0 1 1-3.5-3.5"></path><path d="M12 3c.4 2.6 2.2 4.2 4.8 4.4"></path></svg>
                    </a>
                    <a href="{{#facebook}}{{{facebook}}}{{/facebook}}{{^facebook}}https://www.facebook.com/kursybusola{{/facebook}}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="busola-social-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h2.5V4.5H14A4 4 0 0 0 10 8.5V11H7.5v3.5H10V21h3.5v-6.5h2.6l.6-3.5h-3.2V9c0-.6.4-1 1-1z"></path></svg>
                    </a>
                    <a href="{{#instagram}}{{{instagram}}}{{/instagram}}{{^instagram}}https://www.instagram.com/kursybusola{{/instagram}}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="busola-social-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5"></rect><circle cx="12" cy="12" r="3.6"></circle><path d="M16.8 7.2h.01"></path></svg>
                    </a>
                </div>
            </div>
        </div>

        <div class="busola-footer-bottom">
            <div>Wspierane przez <a href="https://moodle.org" target="_blank" rel="noopener noreferrer">Moodle</a></div>
            <div>Szkoła Żeglarstwa Busola &copy; 2026</div>
        </div>
    </div>

    <div class="d-none">
        {{{ output.standard_footer_html }}}
        {{{ output.login_info }}}
        <div class="tool_usertours-resettourcontainer"></div>
    </div>
</footer>

{{{ output.standard_end_of_body_html }}}
