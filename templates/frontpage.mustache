{{!
    @template theme_ebusola/frontpage

    Strona główna dla niezalogowanego użytkownika / gościa w motywie eBusola.
    Struktura zgodna z PAGES_GUIDELINES.md i wytycznymi wydajnościowymi ADR 0001.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_ebusola/navbar }}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers has-busola-guest p-0" style="padding-left:0 !important; padding-right:0 !important; max-width:100% !important;">
        {{> theme_ebusola/ebusola/busola_guest }}
        {{{ output.standard_after_main_region_html }}}
    </div>

    <!-- Global Footer (ALWAYS outside #page, directly in #page-wrapper per PAGES_GUIDELINES.md) -->
    {{> theme_ebusola/footer }}
    {{> theme_ebusola/whatsapp_button }}
</div>

</body>
</html>
{{#js}}
    M.util.js_pending('theme_boost/loader');
    require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
        Drawer.init();
        M.util.js_complete('theme_boost/loader');
    });
{{/js}}
