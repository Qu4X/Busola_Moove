{{!
    @template core/editswitch

    Site-wide Edit mode toggle switch for navbar.
    Ensures a reliable, accessible toggle switch is rendered across all Moodle versions.
}}
<form action="{{{legacyseturl}}}" method="post" class="d-flex align-items-center editmode-switch-form mx-2 my-auto">
    <div class="form-check form-switch custom-control custom-switch d-flex align-items-center mb-0">
        <input type="checkbox"
            name="setmode"
            class="form-check-input custom-control-input me-2 cursor-pointer"
            id="{{elementid}}"
            {{#checked}}checked{{/checked}}
            data-context="{{{pagecontextid}}}"
            data-pageurl="{{{pageurl}}}"
            onchange="this.form.submit()">
        <label class="form-check-label custom-control-label font-weight-bold text-nowrap cursor-pointer mb-0" for="{{elementid}}">
            {{#str}} editmode, core {{/str}}
        </label>
    </div>
    <input type="hidden" name="sesskey" value="{{{sesskey}}}">
    <input type="hidden" name="pageurl" value="{{{pageurl}}}">
    <input type="hidden" name="context" value="{{{pagecontextid}}}">
</form>
{{#js}}
require(['core/edit_switch'], function(editSwitch) {
    if (editSwitch && typeof editSwitch.init === 'function') {
        editSwitch.init('{{elementid}}');
    }
});
{{/js}}
