{{!
    @template core/editswitch

    Site-wide Edit mode switch with pencil icon and pixel-perfect hitbox.
}}
<form action="{{{legacyseturl}}}" method="post" class="d-flex align-items-center editmode-switch-form m-0" id="busola-editmode-form">
    <input type="hidden" name="sesskey" value="{{{sesskey}}}">
    <input type="hidden" name="pageurl" value="{{{pageurl}}}">
    <input type="hidden" name="context" value="{{{pagecontextid}}}">
    <input type="hidden" name="setmode" id="busola-editmode-setmode-val" value="{{#checked}}0{{/checked}}{{^checked}}1{{/checked}}">

    <div class="custom-control custom-switch d-inline-flex align-items-center mb-0 cursor-pointer" style="cursor: pointer;">
        <input type="checkbox"
            name="setmode_checkbox"
            class="custom-control-input cursor-pointer"
            id="{{elementid}}"
            {{#checked}}checked{{/checked}}
            onchange="document.getElementById('busola-editmode-setmode-val').value = this.checked ? '1' : '0'; document.getElementById('busola-editmode-form').submit();"
        >
        <label class="custom-control-label cursor-pointer mb-0 d-inline-flex align-items-center" for="{{elementid}}" style="cursor: pointer; user-select: none;" title="{{#str}} editmode, core {{/str}}" aria-label="{{#str}} editmode, core {{/str}}">
            <svg class="ms-1 edit-switch-pencil" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            <span class="visually-hidden">{{#str}} editmode, core {{/str}}</span>
        </label>
    </div>
</form>
