{{!
    Sekcja Hero - powitanie kursanta, radar w tle, karta "Kontynuuj" i fala przejścia.
}}
<section class="busola-hero" aria-label="Sekcja powitalna">
    <svg viewBox="0 0 400 400" width="560" height="560" aria-hidden="true" class="busola-hero-radar" fill="none" stroke="#FFFFFF" stroke-width="1.5">
        <circle cx="200" cy="200" r="190"></circle>
        <circle cx="200" cy="200" r="140"></circle>
        <circle cx="200" cy="200" r="90"></circle>
        <path d="M200 0V400M0 200H400M59 59L341 341M341 59L59 341"></path>
    </svg>
    <div class="busola-hero-container">
        <div class="busola-hero-welcome">
            <h1 class="busola-hero-title">{{#str}}hero_greeting, theme_ebusola, {{firstname}}{{/str}}</h1>
            {{#haslastcourse}}
                <p class="busola-hero-subtitle">{{#str}}hero_last_learned, theme_ebusola, {{lastcourse.fullname}}{{/str}}</p>
            {{/haslastcourse}}
            {{^haslastcourse}}
                <p class="busola-hero-subtitle">{{#str}}hero_welcome_default, theme_ebusola{{/str}}</p>
            {{/haslastcourse}}
            <div class="busola-hero-badges">
                {{#has_totalcourses}}
                    <span class="busola-hero-badge">{{totalcourses_label}}</span>
                {{/has_totalcourses}}
                {{#has_completed}}
                    <span class="busola-hero-badge">{{completed_label}}</span>
                {{/has_completed}}
                {{#has_inprogress}}
                    <span class="busola-hero-badge">{{inprogress_label}}</span>
                {{/has_inprogress}}
            </div>
        </div>

        {{#haslastcourse}}
        <a href="{{lastcourse.url}}" class="busola-hero-card">
            <div class="busola-hero-card-icon cat-{{lastcourse.type}}">
                {{#lastcourse.hascustomicon}}
                    {{#lastcourse.hasinlinesvg}}
                        {{{lastcourse.inlinesvg}}}
                    {{/lastcourse.hasinlinesvg}}
                    {{^lastcourse.hasinlinesvg}}
                        <img src="{{lastcourse.iconurl}}" alt="{{lastcourse.fullname}}" class="busola-course-img" loading="eager" fetchpriority="high" decoding="async" width="140" height="88" />
                    {{/lastcourse.hasinlinesvg}}
                {{/lastcourse.hascustomicon}}
                {{^lastcourse.hascustomicon}}
                    <svg viewBox="0 0 160 100" width="140" height="88" aria-hidden="true">
                        <rect x="24" y="48" width="12" height="22" rx="3" fill="#FF7A1A" stroke="#141B5E" stroke-width="2.5"></rect>
                        <path d="M32 62 H132 L120 80 H48 Z" fill="#FFFFFF" stroke="#141B5E" stroke-width="2.5" stroke-linejoin="round"></path>
                        <path d="M66 62 L80 42 H104 L112 62" fill="none" stroke="#141B5E" stroke-width="2.5" stroke-linejoin="round"></path>
                    </svg>
                {{/lastcourse.hascustomicon}}
            </div>
            <div class="busola-hero-card-body">
                <div class="busola-hero-card-info">
                    <span class="busola-hero-card-tag">{{#str}}hero_continue, theme_ebusola{{/str}}</span>
                    <span class="busola-hero-card-title">{{lastcourse.fullname}}</span>
                    <span class="busola-hero-card-desc">
                        {{#lastcourse.iscompleted}}{{#str}}course_status_completed, theme_ebusola{{/str}}{{/lastcourse.iscompleted}}
                        {{#lastcourse.isinprogress}}{{#str}}course_status_progress, theme_ebusola, {{lastcourse.progress}}{{/str}}{{/lastcourse.isinprogress}}
                        {{#lastcourse.isnotstarted}}{{#str}}course_status_not_started, theme_ebusola{{/str}}{{/lastcourse.isnotstarted}}
                    </span>
                </div>
                <div class="busola-hero-card-progress">
                    <div class="busola-progress-track">
                        <div class="busola-progress-bar" style="width:{{lastcourse.progress}}%;"></div>
                    </div>
                    <span class="busola-progress-val">{{lastcourse.progress}}%</span>
                </div>
                <span class="busola-hero-card-btn">
                    {{#str}}hero_resume, theme_ebusola{{/str}}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </span>
            </div>
        </a>
        {{/haslastcourse}}
    </div>

    <!-- Falowana krzywa przejścia na dole sekcji hero z tokenem tła -->
    <svg viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true" class="busola-hero-wave">
        <path d="M0 50V26C220 4 440 4 720 26S1200 50 1440 22V50Z"></path>
    </svg>
</section>
