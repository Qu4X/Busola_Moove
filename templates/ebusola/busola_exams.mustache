{{!
    Baner Egzaminy dla dorosłych - dynamiczne dane z aktywności Moodle.
}}
<section aria-labelledby="h-egz" class="busola-exam-banner">
    <div class="busola-exam-icon-wrap">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 3h8l4 4v14H7z"></path>
            <path d="M15 3v4h4"></path>
            <path d="M10 14.5l2 2 3.5-4"></path>
        </svg>
    </div>
    <div class="busola-exam-content">
        <h2 id="h-egz" class="busola-exam-title">{{{exam_title}}}</h2>
        <p class="busola-exam-desc">{{{exam_desc}}}</p>
    </div>
    <a href="{{{examurl}}}" class="busola-exam-btn">
        {{{exam_btn_text}}}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
</section>
