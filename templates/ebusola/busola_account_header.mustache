<script>
(function() {
    function initBusolaAccountForms() {
        // 1. Injected Password Prompt Card
        var moodleSection = document.getElementById('id_moodle');
        if (moodleSection && !document.getElementById('busola-password-card')) {
            var card = document.createElement('section');
            card.id = 'busola-password-card';
            card.className = 'busola-password-prompt-card';
            var changePwdUrl = (typeof M !== 'undefined' && M.cfg ? M.cfg.wwwroot : '') + '/login/change_password.php';
            card.innerHTML = '<h2 style="margin:0 0 14px;font-size:22px;font-weight:800;letter-spacing:-.01em">Hasło</h2>' +
                '<p style="margin:0 0 14px;font-size:15px;color:inherit">Aby zmienić hasło, podaj obecne i ustaw nowe.</p>' +
                '<a href="' + changePwdUrl + '" class="btn-change-password-link" style="display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border-radius:12px;border:2px solid currentColor;font-weight:700;font-size:15px;text-decoration:none">' +
                '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>' +
                'Zmień hasło</a>';
            moodleSection.parentNode.insertBefore(card, moodleSection.nextSibling);
        }

        // 2. Picture layout: 2 columns (Avatar + Delete on left, Dropzone on right)
        var picFs = document.getElementById('id_moodle_picture');
        var currPic = document.getElementById('fitem_id_currentpicture');
        var delPic = document.querySelector('input[name="deletepicture"]');
        var delPicItem = delPic ? delPic.closest('.fitem') : null;
        var imageFile = document.getElementById('fitem_id_imagefile');
        if (picFs && currPic && imageFile && !picFs.querySelector('.busola-picture-row')) {
            var row = document.createElement('div');
            row.className = 'busola-picture-row';
            var leftCol = document.createElement('div');
            leftCol.className = 'busola-picture-left-col';
            var rightCol = document.createElement('div');
            rightCol.className = 'busola-picture-right-col';
            
            currPic.parentNode.insertBefore(row, currPic);
            leftCol.appendChild(currPic);
            if (delPicItem) leftCol.appendChild(delPicItem);
            rightCol.appendChild(imageFile);
            
            row.appendChild(leftCol);
            row.appendChild(rightCol);
        }

        // 3. Group Other Settings into single card
        var otherIds = ['id_moodle_additional_names', 'id_moodle_interests', 'id_moodle_optional', 'id_category_3'];
        var otherElements = otherIds.map(function(id) { return document.getElementById(id); }).filter(Boolean);
        if (otherElements.length > 0 && !document.querySelector('.busola-other-settings-card')) {
            var first = otherElements[0];
            var otherCard = document.createElement('section');
            otherCard.className = 'busola-other-settings-card';
            otherCard.innerHTML = '<h3 class="busola-other-settings-title">Pozostałe ustawienia</h3><div class="busola-other-settings-list"></div>';
            first.parentNode.insertBefore(otherCard, first);
            var list = otherCard.querySelector('.busola-other-settings-list');
            otherElements.forEach(function(el) { list.appendChild(el); });
        }

        // 4. Move required legend to sticky footer / action bar
        var reqLegend = document.querySelector('.fdescription.required:not(.busola-required-legend)');
        var stickyContent = document.querySelector('#sticky-footer .sticky-footer-content') ||
                            document.querySelector('#fgroup_id_buttonar .felement .d-flex');
        if (reqLegend && stickyContent && !stickyContent.querySelector('.busola-required-legend')) {
            var span = document.createElement('span');
            span.className = 'busola-required-legend';
            span.innerHTML = '<span style="color:#B93C00;font-weight:700">*</span> Pole wymagane';
            stickyContent.appendChild(span);
            reqLegend.style.display = 'none';
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBusolaAccountForms);
    } else {
        initBusolaAccountForms();
    }
})();
</script>
