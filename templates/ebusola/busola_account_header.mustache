<style id="busola-account-forms-style">
/* -------------------------------------------------------------------------
   Busola Account Forms: Edit Profile & Change Password
   Matches Figma mockups:
   - "Edycja profilu – desktop-html" & "Edycja profilu – mobile-html"
   - "Zmiana hasła – desktop-html" & "Zmiana hasła – mobile-html"
