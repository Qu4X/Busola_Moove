    color: #3A4163 !important;
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
}

/* Hide default Moodle boost header when busola header is rendered */
#page-user-edit #page-header,
#page-user-editadvanced #page-header,
#page-login-change_password #page-header {
    display: none !important;
}

/* Layout container sizing */
