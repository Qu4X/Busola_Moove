{{!
    Sekcja Moje Kursy - kafelki z pastelowymi tłami, postępem, ikonami kursów i statusami.
}}
<section aria-labelledby="h-moje" class="busola-section-mycourses">
    <div class="busola-section-header">
        <h2 id="h-moje" class="busola-section-title">{{#str}}mycourses_heading, theme_ebusola{{/str}}</h2>
        <a href="{{allcoursesurl}}" class="busola-link-all">
            {{#str}}mycourses_all, theme_ebusola{{/str}}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
    </div>

    {{#hascourses}}
    <div class="busola-courses-grid">
        {{#courses}}
        <a href="{{url}}" class="busola-course-card">
            <div class="busola-card-banner cat-{{type}}">
                <span class="busola-card-badge">{{categoryname}}</span>
                {{#hascustomicon}}
                    <img src="{{iconurl}}" alt="{{fullname}}" class="busola-card-img" />
                {{/hascustomicon}}
                {{^hascustomicon}}
                    <svg viewBox="0 0 160 100" width="160" height="100" aria-hidden="true" class="busola-card-svg">
                        <rect x="24" y="48" width="12" height="22" rx="3" fill="#FF7A1A" stroke="#141B5E" stroke-width="2.5"></rect>
                        <path d="M32 62 H132 L120 80 H48 Z" fill="#FFFFFF" stroke="#141B5E" stroke-width="2.5" stroke-linejoin="round"></path>
                        <path d="M66 62 L80 42 H104 L112 62" fill="none" stroke="#141B5E" stroke-width="2.5" stroke-linejoin="round"></path>
                    </svg>
                {{/hascustomicon}}
            </div>
            <div class="busola-card-body">
                <div class="busola-card-title">{{fullname}}</div>
                <div class="busola-card-subtitle">
                    {{#iscompleted}}{{#str}}course_status_completed, theme_ebusola{{/str}}{{/iscompleted}}
                    {{#isinprogress}}{{#str}}course_status_progress, theme_ebusola, {{progress}}{{/str}}{{/isinprogress}}
                    {{#isnotstarted}}{{#str}}course_status_not_started, theme_ebusola{{/str}}{{/isnotstarted}}
                </div>
                <div class="busola-card-footer">
                    {{#iscompleted}}
                        <div class="busola-card-progress-wrap">
                            <div class="busola-progress-track"><div class="busola-progress-bar done" style="width:100%;"></div></div>
                        </div>
                        <span class="busola-status-completed">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                            {{#str}}course_status_done, theme_ebusola{{/str}}
                        </span>
                    {{/iscompleted}}
                    {{#isinprogress}}
                        <div class="busola-card-progress-wrap">
                            <div class="busola-progress-track"><div class="busola-progress-bar" style="width:{{progress}}%;"></div></div>
                            <span class="busola-progress-percent">{{progress}}%</span>
                        </div>
                        <span class="busola-card-action">
                            {{#str}}course_action_continue, theme_ebusola{{/str}}
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                        </span>
                    {{/isinprogress}}
                    {{#isnotstarted}}
                        <span class="busola-card-action">
                            {{#str}}course_action_start, theme_ebusola{{/str}}
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                        </span>
                    {{/isnotstarted}}
                </div>
            </div>
        </a>
        {{/courses}}
    </div>
    {{/hascourses}}

    {{^hascourses}}
    <div class="busola-empty-courses">
        <p class="busola-empty-text">{{#str}}mycourses_not_enrolled, theme_ebusola{{/str}}</p>
        <a href="{{allcoursesurl}}" class="busola-empty-btn">{{#str}}mycourses_browse, theme_ebusola{{/str}}</a>
    </div>
    {{/hascourses}}
</section>
