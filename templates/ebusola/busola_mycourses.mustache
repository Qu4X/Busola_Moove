{{!
    Sekcja Moje Kursy - kafelki z pastelowymi tłami, postępem, ikonami kursów i statusami.
}}
<section aria-labelledby="h-moje">
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:24px;">
        <h2 id="h-moje" style="margin:0;font-size:30px;font-weight:800;letter-spacing:-.015em;color:#141B5E;">Moje kursy</h2>
        <a href="{{allcoursesurl}}" style="display:inline-flex;align-items:center;gap:6px;font-weight:700;font-size:15px;text-decoration:none;border-bottom:2px solid #FF7A1A;padding-bottom:1px;color:#141B5E;">
            Wszystkie kursy
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
    </div>

    {{#hascourses}}
    <div style="display:flex;flex-wrap:wrap;gap:24px;">
        {{#courses}}
        <a href="{{url}}" class="bcard" style="flex:1 1 300px;min-width:0;max-width:380px;display:flex;flex-direction:column;background:#FFFFFF;border-radius:20px;overflow:hidden;text-decoration:none;color:#3A4163;box-shadow:0 1px 2px rgba(20,27,94,.06),0 8px 24px rgba(20,27,94,.06);">
            <div style="position:relative;height:170px;background:{{bgcolor}};display:flex;align-items:center;justify-content:center;">
                <span style="position:absolute;left:16px;top:16px;padding:5px 12px;border-radius:999px;background:#FFFFFF;color:#141B5E;font-size:12px;font-weight:700;box-shadow:0 1px 3px rgba(0,0,0,.08);">{{categoryname}}</span>
                {{#hascustomicon}}
                    <img src="{{iconurl}}" alt="{{fullname}}" style="max-width:130px;max-height:110px;object-fit:contain;margin-top:14px;" />
                {{/hascustomicon}}
                {{^hascustomicon}}
                    <svg viewBox="0 0 160 100" width="160" height="100" aria-hidden="true" style="display:block;margin-top:14px;">
                        <rect x="24" y="48" width="12" height="22" rx="3" fill="#FF7A1A" stroke="#141B5E" stroke-width="2.5"></rect>
                        <path d="M32 62 H132 L120 80 H48 Z" fill="#FFFFFF" stroke="#141B5E" stroke-width="2.5" stroke-linejoin="round"></path>
                        <path d="M66 62 L80 42 H104 L112 62" fill="none" stroke="#141B5E" stroke-width="2.5" stroke-linejoin="round"></path>
                    </svg>
                {{/hascustomicon}}
            </div>
            <div style="padding:20px 22px 22px;display:flex;flex-direction:column;flex:1;">
                <div style="font-size:19px;font-weight:700;color:#141B5E;line-height:1.25;">{{fullname}}</div>
                <div style="margin-top:4px;font-size:14px;color:#5B6280;">
                    {{#iscompleted}}Kurs ukończony (100%){{/iscompleted}}
                    {{#isinprogress}}{{progress}}% ukończono{{/isinprogress}}
                    {{#isnotstarted}}Jeszcze nie zacząłeś{{/isnotstarted}}
                </div>
                <div style="margin-top:auto;padding-top:16px;">
                    {{#iscompleted}}
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                            <div style="flex:1;height:8px;border-radius:4px;background:#E3E7F4;overflow:hidden;"><div style="height:100%;width:100%;border-radius:4px;background:#141B5E;"></div></div>
                        </div>
                        <span style="display:inline-flex;align-items:center;gap:4px;font-size:14px;font-weight:700;color:#141B5E;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
                            Ukończony
                        </span>
                    {{/iscompleted}}
                    {{#isinprogress}}
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;">
                            <div style="flex:1;height:8px;border-radius:4px;background:#E3E7F4;overflow:hidden;"><div style="height:100%;width:{{progress}}%;border-radius:4px;background:#FF7A1A;"></div></div>
                            <span style="font-size:14px;font-weight:700;color:#141B5E;white-space:nowrap;">{{progress}}%</span>
                        </div>
                        <span style="display:inline-flex;align-items:center;gap:6px;font-size:15px;font-weight:700;color:#141B5E;border-bottom:2px solid #FF7A1A;padding-bottom:1px;">
                            Kontynuuj kurs
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                        </span>
                    {{/isinprogress}}
                    {{#isnotstarted}}
                        <span style="display:inline-flex;align-items:center;gap:6px;font-size:15px;font-weight:700;color:#141B5E;border-bottom:2px solid #FF7A1A;padding-bottom:1px;">
                            Rozpocznij kurs
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                        </span>
                    {{/isnotstarted}}
                </div>
            </div>
        </a>
        {{/courses}}
    </div>
    {{/hascourses}}

    {{^hascourses}}
    <div style="background:#FFFFFF;border-radius:20px;padding:40px 24px;text-align:center;box-shadow:0 1px 2px rgba(20,27,94,.06);">
        <p style="font-size:18px;color:#5B6280;margin-bottom:20px;">Nie jesteś jeszcze zapisany na żaden kurs.</p>
        <a href="{{allcoursesurl}}" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:14px;background:#FF7A1A;color:#141B5E;font-size:15px;font-weight:700;text-decoration:none;">Przeglądaj ofertę kursów</a>
    </div>
    {{/hascourses}}
</section>
