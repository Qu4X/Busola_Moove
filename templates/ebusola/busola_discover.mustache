{{!
    Sekcja Odkryj kolejne kursy - tokenizowane kafelki kategorii z listą nieodkrytych kursów.
}}
<section aria-labelledby="h-odkryj" class="busola-section-discover">
    <h2 id="h-odkryj" class="busola-section-title">{{#str}}discover_heading, theme_ebusola{{/str}}</h2>
    <div class="busola-discover-grid">
        {{#discover}}
        <div class="busola-discover-card cat-{{icon}}">
            <a href="{{targeturl}}" class="busola-discover-card-main">
                <div class="busola-discover-icon">
                    {{#is_sail}}
                        <svg viewBox="0 0 160 100" width="68" height="42" aria-hidden="true" class="busola-discover-svg">
                            <path d="M40 70 L120 70 L110 84 L50 84 Z" fill="var(--busola-svg-surface, #FFFFFF)" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5" stroke-linejoin="round"></path>
                            <path d="M50 78 L110 78" stroke="var(--busola-svg-accent, #FF7A1A)" stroke-width="2.5"></path>
                            <path d="M78 68 L78 20 L44 68 Z" fill="var(--busola-svg-navy, #24308A)" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5" stroke-linejoin="round"></path>
                            <path d="M82 68 L82 28 L114 68 Z" fill="var(--busola-svg-navy, #3D4EB8)" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5" stroke-linejoin="round"></path>
                        </svg>
                    {{/is_sail}}
                    {{#is_motor}}
                        <svg viewBox="0 0 160 100" width="68" height="42" aria-hidden="true" class="busola-discover-svg">
                            <rect x="24" y="48" width="12" height="22" rx="3" fill="var(--busola-svg-accent, #FF7A1A)" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5"></rect>
                            <path d="M32 62 H132 L120 80 H48 Z" fill="var(--busola-svg-surface, #FFFFFF)" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5" stroke-linejoin="round"></path>
                            <path d="M66 62 L80 42 H104 L112 62" fill="none" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5" stroke-linejoin="round"></path>
                        </svg>
                    {{/is_motor}}
                    {{#is_extra}}
                        <svg viewBox="0 0 160 100" width="68" height="42" aria-hidden="true" class="busola-discover-svg">
                            <path d="M68 28 L68 44" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5" stroke-linecap="round"></path>
                            <circle cx="68" cy="26" r="3" fill="var(--busola-svg-accent, #FF7A1A)"></circle>
                            <rect x="44" y="44" width="72" height="42" rx="6" fill="var(--busola-svg-surface, #FFFFFF)" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2.5"></rect>
                            <rect x="52" y="52" width="22" height="12" rx="2" fill="var(--busola-cat-extra-bg, #FFE8D4)" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="1.5"></rect>
                            <circle cx="96" cy="58" r="4" fill="var(--busola-svg-accent, #FF7A1A)"></circle>
                            <line x1="52" y1="74" x2="108" y2="74" stroke="var(--busola-svg-outline, #141B5E)" stroke-width="2" stroke-linecap="round"></line>
                        </svg>
                    {{/is_extra}}
                </div>
                <div class="busola-discover-text">
                    <h3 class="busola-discover-title">{{title}}</h3>
                    <p class="busola-discover-status">{{status_label}}</p>
                </div>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="busola-discover-chevron" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </a>
            {{#has_courses}}
                <div class="busola-discover-links">
                    {{#courses}}
                        <a href="{{url}}" class="busola-discover-link">
                            {{fullname}}
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                        </a>
                    {{/courses}}
                </div>
            {{/has_courses}}
        </div>
        {{/discover}}
    </div>
</section>
