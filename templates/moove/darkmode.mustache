<div id="toggle-darkmode" class="d-flex align-items-center">
    <label for="toggle-darkmode-input" class="darkmode-icon-holder d-inline-flex align-items-center mb-0 cursor-pointer me-1" aria-label="Toggle dark mode" style="cursor: pointer;">
        <svg class="darkmode-icon icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"></path>
        </svg>
        <svg class="darkmode-icon icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.7-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd"></path>
        </svg>
    </label>
    <div class="custom-control custom-switch d-inline-flex align-items-center mb-0 cursor-pointer">
        <input type="checkbox" class="custom-control-input cursor-pointer" id="toggle-darkmode-input" {{#darkmode}}checked{{/darkmode}}>
        <label class="custom-control-label cursor-pointer mb-0" for="toggle-darkmode-input" aria-label="Dark mode switch"></label>
    </div>
</div>

{{#js}}
    require(['theme_ebusola/darkmode'], function(DarkMode) {
        DarkMode.init();
    });
{{/js}}
